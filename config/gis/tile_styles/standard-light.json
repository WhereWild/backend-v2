{
  "version": 8,
  "name": "WhereWild Standard Light",
  "metadata": {
    "ww:note": "Fork of CARTO Positron (github.com/CartoDB/basemap-styles/blob/master/mapboxgl/positron.json) \u2014 the actual open-source style CARTO publishes: code under BSD-3-Clause, visual design under CC-BY 4.0 (see LICENSE.md in that repo). Paint values below are ported directly from that file (fetched 2026-08-16), not from Stadia's Alidade Smooth \u2014 that's a further, non-redistributable customization of this same CARTO base. Layers with NO CARTO equivalent \u2014 the extra landcover classes (grass/scrub/wetland/ice/sand/rock), ferry, and mountain-peak \u2014 are WhereWild's own additions using the same tint idiom as CARTO's wood/park layers, not upstream values. Required attribution per CC-BY 4.0: 'CARTO', 'OpenMapTiles', 'OpenStreetMap contributors', all linked, visible on or reasonably reachable from the map (see TILE_ATTRIBUTION in the frontend). 'variable-light.json' is derived from this file by build_basemap_tiles.py (clutter source-layers hidden)."
  },
  "glyphs": "{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "mbtiles://{openmaptiles}"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#fafaf8"
      }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "wood"
      ],
      "paint": {
        "fill-color": "rgba(234, 241, 233, 0.5)"
      }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
