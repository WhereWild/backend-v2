      "paint": {
        "text-color": "#7a96a0",
        "text-halo-color": "#f5f5f3",
        "text-halo-width": 1
      }
    },
    {
      "id": "mountain-peak",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "mountain_peak",
      "minzoom": 8,
      "layout": {
        "text-field": [
          "case",
          [
            "has",
            "ele"
          ],
          [
            "concat",
            "\u25b2 ",
            [
              "get",
              "name"
            ],
            " (",
            [
              "to-string",
              [
                "get",
                "ele"
              ]
            ],
            "m)"
          ],
          [
            "concat",
            "\u25b2 ",
            [
              "get",
              "name"
            ]
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10
      },
      "paint": {
        "text-color": "#697b89",
        "text-halo-color": "rgba(255,255,255,0.5)",
        "text-halo-width": 1.2
      }
    },
