        ],
        "minor"
      ],
      "minzoom": 13,
      "paint": {
        "line-color": "#fdfdfd",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          0.5,
          18,
          4
        ]
      }
    },
    {
      "id": "road-secondary-trunk-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "secondary",
            "tertiary",
            "trunk"
          ]
        ]
      ],
      "minzoom": 7,
