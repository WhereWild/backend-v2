{
  "version": 8,
  "name": "WhereWild Variable Light",
  "metadata": {
    "ww:note": "Not derived from standard-light.json — Toner-style background is a genuinely different, simpler monochrome design: light land, dark/black water (confirmed directly in openmaptiles/maptiler-toner-gl-style's style.json — water fill-color: rgba(0,0,0,1), background: #fff — the legitimately-licensed BSD/CC-BY OpenMapTiles port of Stamen Toner). Hand-authored to match that using OpenMapTiles layer names: background+water(filled black)+roads+labels, buildings/POI/housenumbers/aeroway hidden. 'landcover' (wood/grass) approximates Toner's dot-pattern texture with a flat light-grey tint since pattern fills need a sprite sheet not yet set up here."
  },
  "glyphs": "{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "mbtiles://{openmaptiles}"
    }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#ffffff" } },
    { "id": "landcover-wood", "type": "fill", "source": "openmaptiles", "source-layer": "landcover", "filter": ["==", ["get", "class"], "wood"], "paint": { "fill-color": "rgba(0, 0, 0, 0.08)" } },
    { "id": "landcover-grass", "type": "fill", "source": "openmaptiles", "source-layer": "landcover", "filter": ["==", ["get", "class"], "grass"], "paint": { "fill-color": "rgba(0, 0, 0, 0.05)" } },
    { "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water", "filter": ["!=", ["get", "brunnel"], "tunnel"], "paint": { "fill-color": "#000000" } },
    { "id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway", "paint": { "line-color": "#000000", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 16, 2] } },
    { "id": "boundary-state", "type": "line", "source": "openmaptiles", "source-layer": "boundary", "filter": ["==", ["get", "admin_level"], 4], "paint": { "line-color": "#000000", "line-width": 0.75, "line-dasharray": [3, 2] } },
    { "id": "boundary-country", "type": "line", "source": "openmaptiles", "source-layer": "boundary", "filter": ["==", ["get", "admin_level"], 2], "paint": { "line-color": "#000000", "line-width": 1 } },
    { "id": "rail", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["==", ["get", "class"], "rail"], "minzoom": 8, "paint": { "line-color": "#444444", "line-width": 0.75, "line-dasharray": [3, 2] } },
    { "id": "road-path", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["in", ["get", "class"], ["literal", ["path", "track"]]], "minzoom": 14, "paint": { "line-color": "#999999", "line-width": 0.5, "line-dasharray": [1, 1] } },
    { "id": "road-minor", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["in", ["get", "class"], ["literal", ["minor", "service"]]], "minzoom": 12, "paint": { "line-color": "#444444", "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.3, 18, 3] } },
    { "id": "road-major", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["in", ["get", "class"], ["literal", ["secondary", "tertiary", "primary"]]], "minzoom": 8, "paint": { "line-color": "#222222", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 18, 8] } },
    { "id": "road-trunk-motorway", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["in", ["get", "class"], ["literal", ["trunk", "motorway"]]], "minzoom": 5, "paint": { "line-color": "#000000", "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.75, 18, 10] } },
    {
      "id": "water-name", "type": "symbol", "source": "openmaptiles", "source-layer": "water_name", "minzoom": 3,
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Italic"], "text-size": ["interpolate", ["linear"], ["zoom"], 3, 10, 10, 14] },
      "paint": { "text-color": "#ffffff", "text-halo-width": 0 }
    },
    {
      "id": "road-label", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name", "minzoom": 13,
      "layout": { "symbol-placement": "line", "text-field": ["get", "name"], "text-font": ["Noto Sans Regular"], "text-size": 10 },
      "paint": { "text-color": "#000000", "text-halo-color": "#ffffff", "text-halo-width": 1.5 }
    },
    {
      "id": "place-city", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "filter": ["==", ["get", "class"], "city"], "maxzoom": 12,
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Bold"], "text-size": ["interpolate", ["linear"], ["zoom"], 4, 10, 12, 16] },
      "paint": { "text-color": "#000000", "text-halo-color": "#ffffff", "text-halo-width": 2 }
    },
    {
      "id": "place-town-village", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "filter": ["in", ["get", "class"], ["literal", ["town", "village"]]], "minzoom": 8,
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Regular"], "text-size": 12 },
      "paint": { "text-color": "#000000", "text-halo-color": "#ffffff", "text-halo-width": 2 }
    },
    {
      "id": "place-state", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "filter": ["==", ["get", "class"], "state"], "minzoom": 3, "maxzoom": 12,
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Bold"], "text-size": ["interpolate", ["linear"], ["zoom"], 3, 9, 8, 13], "text-transform": "uppercase", "text-letter-spacing": 0.08 },
      "paint": { "text-color": "#000000", "text-halo-color": "#ffffff", "text-halo-width": 2 }
    },
    {
      "id": "place-country", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "filter": ["==", ["get", "class"], "country"], "minzoom": 1, "maxzoom": 10,
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Bold"], "text-size": ["interpolate", ["linear"], ["zoom"], 1, 9, 6, 14], "text-transform": "uppercase", "text-letter-spacing": 0.1 },
      "paint": { "text-color": "#000000", "text-halo-color": "#ffffff", "text-halo-width": 2 }
    }
  ]
}
